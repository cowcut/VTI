# Local development only. Do not commit real values.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_customer_support
JWT_SECRET=replace-with-a-long-random-secret

# Gemini API (create or rotate a key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash

# Optional local frontend origins. Production requires this variable.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
