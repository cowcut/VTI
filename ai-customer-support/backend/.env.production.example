# Configure these values in your backend host's secret/environment-variable UI.
NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://<atlas-user>:<atlas-password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-secret
GEMINI_API_KEY=create-a-new-key-after-revoking-the-old-one
GEMINI_MODEL=gemini-3.7-flash
CORS_ORIGINS=https://support.suptid.fun
