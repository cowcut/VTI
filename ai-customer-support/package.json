{
  "name": "ai-customer-support",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "cd frontend && vite",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix backend test",
    "lint:frontend": "npm --prefix frontend run lint",
    "test": "npm run test:backend && npm run lint:frontend",
    "clean": "rm -rf backend/dist frontend/dist frontend/.cache"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "morgan": "^1.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
